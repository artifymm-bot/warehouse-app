rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /products/{id} {
      allow read, write: if signedIn();
    }

    match /orders/{id} {
      allow read, write: if signedIn();
    }

    match /customers/{id} {
      allow read, write: if signedIn();
    }

    match /packers/{id} {
      allow read, write: if signedIn();
    }
  }
}